<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Cap7CE.Core.Setup</AssemblyName>
    <RootNamespace>Cap7CE.Core.Setup</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <CapabilitySetupManifestPath Condition="'$(CapabilitySetupManifestPath)' == ''">..\..\deployment\capability-setup-manifest.v1.json</CapabilitySetupManifestPath>
    <DefineConstants Condition="'$(P37LifecycleProfile)' == 'true'">$(DefineConstants);P37_LIFECYCLE</DefineConstants>
    <DefineConstants Condition="'$(P38ProductProfile)' == 'true'">$(DefineConstants);P38_PRODUCT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Cap7CE.Core.Layer" Value="Setup" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(CapabilitySetupManifestPath)"
                      LogicalName="Cap7CE.Core.Setup.capability-setup-manifest.v1.json" />
  </ItemGroup>
  <ItemGroup Condition="'$(CapabilityPayloadManifestPath)' != ''">
    <EmbeddedResource Include="$(CapabilityPayloadManifestPath)"
                      LogicalName="Cap7CE.Core.Setup.capability-payload-manifest.v1.json" />
  </ItemGroup>
</Project>
