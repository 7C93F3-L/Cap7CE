{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node", "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "esModuleInterop": true,
    "skipLibCheck": true, "noEmit": true, "types": ["node"]
  },
  "include": ["visualCache", "visualRendering", "interactiveMetadata", "localKeywords", "modelSettings", "transport", "modelRuntime", "storedMetadata"]
}
