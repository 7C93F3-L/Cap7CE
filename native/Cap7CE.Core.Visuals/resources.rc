#include <winver.h>
#include "resource-version.h"

101 ICON "icon.ico"
1 VERSIONINFO
FILEVERSION CAP_VERSION_MAJOR,CAP_VERSION_MINOR,CAP_VERSION_PATCH,0
PRODUCTVERSION CAP_VERSION_MAJOR,CAP_VERSION_MINOR,CAP_VERSION_PATCH,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Cap7CE Background Worker\0"
            VALUE "FileVersion", CAP_VERSION_TEXT
            VALUE "ProductName", "Cap7CE\0"
            VALUE "ProductVersion", CAP_VERSION_TEXT
            VALUE "InternalName", "Cap7CE.Core.Visuals\0"
            VALUE "OriginalFilename", "Cap7CE.Core.Visuals.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
