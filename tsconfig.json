{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noEmitOnError": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "core/node",
    "core/shared"
  ]
}
