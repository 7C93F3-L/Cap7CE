<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="TextFillColorSecondaryBrush"/>
      <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
      <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="TextFillColorPrimaryBrush"/>
      <StaticResource x:Key="HyperlinkButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
      <StaticResource x:Key="HyperlinkButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="TextFillColorSecondaryBrush"/>
      <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush"/>
      <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="TextFillColorPrimaryBrush"/>
      <StaticResource x:Key="HyperlinkButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush"/>
      <StaticResource x:Key="HyperlinkButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <StaticResource x:Key="HyperlinkButtonForeground" ResourceKey="SystemColorWindowTextColorBrush"/>
      <StaticResource x:Key="HyperlinkButtonForegroundPointerOver" ResourceKey="SystemColorHighlightTextColorBrush"/>
      <StaticResource x:Key="HyperlinkButtonForegroundPressed" ResourceKey="SystemColorHighlightTextColorBrush"/>
      <StaticResource x:Key="HyperlinkButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush"/>
      <StaticResource x:Key="HyperlinkButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
