<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Cap7CE.WinUI.Controls">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CapFlyoutSurfaceBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="CapWorkspaceSurfaceBrush" Color="#66FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="CapFlyoutSurfaceBrush" Color="Transparent"/>
      <SolidColorBrush x:Key="CapWorkspaceSurfaceBrush" Color="#4C4A4A4A" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="CapFlyoutSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="CapWorkspaceSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <DataTemplate x:Key="CapAssetTileTemplate"><controls:AssetTile/></DataTemplate>
  <SolidColorBrush x:Key="CapAccentBrush" Color="#7C93F3" />
  <SolidColorBrush x:Key="CapAccentForegroundBrush" Color="#FF1F1F1F" />
  <SolidColorBrush x:Key="CapSecondaryBrush" Color="#68C3C0" />
  <SolidColorBrush x:Key="CapAccentHoverBrush" Color="{Binding Color, Source={StaticResource CapAccentBrush}}" Opacity="0.9"/>
  <SolidColorBrush x:Key="CapAccentPressedBrush" Color="{Binding Color, Source={StaticResource CapAccentBrush}}" Opacity="0.8"/>
  <SolidColorBrush x:Key="CapSolidAccentForegroundBrush" Color="#FF1F1F1F"/>
  <SolidColorBrush x:Key="CapSolidAccentForegroundSecondaryBrush" Color="{Binding Color, Source={StaticResource CapSolidAccentForegroundBrush}}" Opacity="0.5"/>
  <LinearGradientBrush x:Key="CapAccentGradient" StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#7C93F3" Offset="0"/><GradientStop Color="#68C3C0" Offset="1"/></LinearGradientBrush>
  <Thickness x:Key="CapPagePadding">16</Thickness>
  <CornerRadius x:Key="CapPanelRadius">12</CornerRadius>
  <Style x:Key="CapToolButton" TargetType="Button">
    <Setter Property="MinWidth" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="7"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="7"/>
  </Style>
  <Style x:Key="CapPanel" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="12"/>
  </Style>
  <Style x:Key="CapMutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="CapWorkspacePanel" TargetType="Border" BasedOn="{StaticResource CapPanel}">
    <Setter Property="Background" Value="{ThemeResource CapWorkspaceSurfaceBrush}"/>
  </Style>
  <Style x:Key="CapHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,4"/></Style>
  <Style TargetType="MenuFlyoutPresenter"><Setter Property="Background" Value="{ThemeResource CapFlyoutSurfaceBrush}"/></Style>
  <Style TargetType="FlyoutPresenter"><Setter Property="Background" Value="{ThemeResource CapFlyoutSurfaceBrush}"/><Setter Property="CornerRadius" Value="12"/></Style>
</ResourceDictionary>
