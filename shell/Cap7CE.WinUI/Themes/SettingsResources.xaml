<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="CapSettingsCard" TargetType="Border" BasedOn="{StaticResource CapDetailsCard}">
  <Setter Property="Padding" Value="16"/>
  <Setter Property="MinHeight" Value="80"/>
 </Style>
 <Style x:Key="CapSettingsSurface" TargetType="Border" BasedOn="{StaticResource CapWorkspacePanel}">
  <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,5,5"/>
 </Style>
 <Style x:Key="CapSettingsKeycap" TargetType="Border">
  <Setter Property="Padding" Value="10,4"/><Setter Property="CornerRadius" Value="5"/>
  <Setter Property="MinWidth" Value="72"/><Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}"/>
  <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/>
 </Style>
 <Style x:Key="CapSettingsColorPreview" TargetType="Border">
  <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/>
 </Style>
 <Style x:Key="CapSettingsColorFlyout" TargetType="FlyoutPresenter">
  <Setter Property="Background" Value="{ThemeResource CapFlyoutSurfaceBrush}"/>
  <Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="12"/>
  <Setter Property="MinWidth" Value="0"/><Setter Property="MaxWidth" Value="304"/>
 </Style>
 <Style x:Key="CapSettingsNavigation" TargetType="NavigationView">
  <Setter Property="PaneDisplayMode" Value="Auto"/><Setter Property="OpenPaneLength" Value="210"/>
  <Setter Property="CompactModeThresholdWidth" Value="0"/><Setter Property="ExpandedModeThresholdWidth" Value="780"/>
  <Setter Property="IsSettingsVisible" Value="False"/><Setter Property="IsBackButtonVisible" Value="Collapsed"/>
  <Setter Property="IsPaneToggleButtonVisible" Value="True"/><Setter Property="IsTitleBarAutoPaddingEnabled" Value="False"/>
  <Setter Property="PaneTitle" Value=""/>
 </Style>
 <Style x:Key="CapSettingsSignaturePath" TargetType="Path">
  <Setter Property="Fill" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
 </Style>
 <Style x:Key="CapSettingsSignatureTrigger" TargetType="HyperlinkButton">
  <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
  <Setter Property="UseSystemFocusVisuals" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="HyperlinkButton">
   <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
