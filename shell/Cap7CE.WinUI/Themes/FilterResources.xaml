<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <StaticResource x:Key="CapFilterSelectedBackgroundBrush" ResourceKey="CapAccentBrush"/>
      <StaticResource x:Key="CapFilterSelectedForegroundBrush" ResourceKey="CapSolidAccentForegroundBrush"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <StaticResource x:Key="CapFilterSelectedBackgroundBrush" ResourceKey="CapAccentBrush"/>
      <StaticResource x:Key="CapFilterSelectedForegroundBrush" ResourceKey="CapSolidAccentForegroundBrush"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <StaticResource x:Key="CapFilterSelectedBackgroundBrush" ResourceKey="SystemColorHighlightColorBrush"/>
      <StaticResource x:Key="CapFilterSelectedForegroundBrush" ResourceKey="SystemColorHighlightTextColorBrush"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="CapFilterPanel" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource CapWorkspaceSurfaceBrush}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="7,3"/>
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="CapFilterGroupFrame" TargetType="Border"><Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/></Style>
  <Style x:Key="CapFilterSummary" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
  <Style x:Key="CapFilterOption" TargetType="ToggleButton">
    <Setter Property="MinWidth" Value="32"/><Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="6,2"/><Setter Property="CornerRadius" Value="7"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Grid Background="Transparent">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="1"/><Setter Target="Presenter.Opacity" Value="0.8"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Selected.Opacity" Value="1"/><Setter Target="Presenter.Foreground" Value="{ThemeResource CapFilterSelectedForegroundBrush}"/></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Selected.Opacity" Value="1"/><Setter Target="Presenter.Foreground" Value="{ThemeResource CapFilterSelectedForegroundBrush}"/></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Selected.Opacity" Value="1"/><Setter Target="Presenter.Foreground" Value="{ThemeResource CapFilterSelectedForegroundBrush}"/><Setter Target="Presenter.Opacity" Value="0.8"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Presenter.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="Selected.Opacity" Value="0.4"/><Setter Target="Presenter.Foreground" Value="{ThemeResource CapFilterSelectedForegroundBrush}"/><Setter Target="Presenter.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <Border x:Name="Hover" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
        <Border x:Name="Selected" Background="{ThemeResource CapFilterSelectedBackgroundBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"/>
        <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CapFilterSwatch" TargetType="ToggleButton">
    <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/><Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
      <Grid Background="Transparent">
        <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Surface.Opacity" Value="0.75"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Surface.Opacity" Value="0.6"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Checked"><VisualState.Setters><Setter Target="Ring.Opacity" Value="1"/></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPointerOver"><VisualState.Setters><Setter Target="Ring.Opacity" Value="1"/></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedPressed"><VisualState.Setters><Setter Target="Ring.Opacity" Value="1"/><Setter Target="Surface.Opacity" Value="0.6"/></VisualState.Setters></VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Surface.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
          <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="Ring.Opacity" Value="0.4"/><Setter Target="Surface.Opacity" Value="0.4"/></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateManager.VisualStateGroups>
        <ContentPresenter x:Name="Surface" Content="{TemplateBinding Content}" Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Ellipse Width="16" Height="16" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1" IsHitTestVisible="False"/>
        <Ellipse x:Name="Ring" Stroke="{ThemeResource CapSecondaryBrush}" StrokeThickness="2" Opacity="0" IsHitTestVisible="False"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CapFilterAction" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="6,2"/><Setter Property="CornerRadius" Value="7"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
  </Style>
</ResourceDictionary>
