<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <StaticResource x:Key="CapFilterCalendarAccentBrush" ResourceKey="CapAccentBrush"/>
   <StaticResource x:Key="CapFilterCalendarContrastBrush" ResourceKey="CapAccentForegroundBrush"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Default">
   <StaticResource x:Key="CapFilterCalendarAccentBrush" ResourceKey="CapAccentBrush"/>
   <StaticResource x:Key="CapFilterCalendarContrastBrush" ResourceKey="CapAccentForegroundBrush"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <StaticResource x:Key="CapFilterCalendarAccentBrush" ResourceKey="SystemColorHighlightColorBrush"/>
   <StaticResource x:Key="CapFilterCalendarContrastBrush" ResourceKey="SystemColorHighlightTextColorBrush"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style x:Key="CapFilterCalendarView" TargetType="CalendarView" BasedOn="{StaticResource DefaultCalendarViewStyle}">
  <Setter Property="FocusBorderBrush" Value="{ThemeResource CapFilterCalendarAccentBrush}"/>
  <Setter Property="SelectedBorderBrush" Value="{ThemeResource CapFilterCalendarAccentBrush}"/>
  <Setter Property="SelectedHoverBorderBrush" Value="{ThemeResource CapFilterCalendarAccentBrush}"/>
  <Setter Property="SelectedForeground" Value="{ThemeResource CapFilterCalendarAccentBrush}"/>
  <Setter Property="SelectedHoverForeground" Value="{ThemeResource CapFilterCalendarAccentBrush}"/>
  <Setter Property="SelectedPressedForeground" Value="{ThemeResource CapFilterCalendarAccentBrush}"/>
  <Setter Property="TodayBackground" Value="{ThemeResource CapFilterCalendarAccentBrush}"/>
  <Setter Property="TodayHoverBackground" Value="{ThemeResource CapFilterCalendarAccentBrush}"/>
  <Setter Property="TodayPressedBackground" Value="{ThemeResource CapFilterCalendarAccentBrush}"/>
  <Setter Property="TodayBlackoutBackground" Value="{ThemeResource CapFilterCalendarAccentBrush}"/>
  <Setter Property="TodayForeground" Value="{ThemeResource CapFilterCalendarContrastBrush}"/>
  <Setter Property="TodayBlackoutForeground" Value="{ThemeResource CapFilterCalendarContrastBrush}"/>
  <Setter Property="TodaySelectedInnerBorderBrush" Value="{ThemeResource CapFilterCalendarContrastBrush}"/>
 </Style>
</ResourceDictionary>
