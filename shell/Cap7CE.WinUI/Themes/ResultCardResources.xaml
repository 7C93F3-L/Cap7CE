<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:language="using:Cap7CE.WinUI.Localization">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CapResultSurfaceBrush" Color="#80FFFFFF"/>
      <SolidColorBrush x:Key="CapResultCaptionBrush" Color="#0E000000"/>
      <SolidColorBrush x:Key="CapResultSelectionBrush" Color="#686868"/>
      <SolidColorBrush x:Key="CapResultSelectionTextBrush" Color="#E4000000"/>
      <SolidColorBrush x:Key="CapResultHoverStrokeBrush" Color="#66000000"/>
      <SolidColorBrush x:Key="CapResultRestStrokeBrush" Color="#20000000"/>
      <SolidColorBrush x:Key="CapResultSelectedCaptionBrush" Color="#24000000"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="CapResultSurfaceBrush" Color="#0FFFFFFF"/>
      <SolidColorBrush x:Key="CapResultCaptionBrush" Color="#20000000"/>
      <SolidColorBrush x:Key="CapResultSelectionBrush" Color="#C2C2C2"/>
      <SolidColorBrush x:Key="CapResultSelectionTextBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="CapResultHoverStrokeBrush" Color="#80FFFFFF"/>
      <SolidColorBrush x:Key="CapResultRestStrokeBrush" Color="#24FFFFFF"/>
      <SolidColorBrush x:Key="CapResultSelectedCaptionBrush" Color="#30FFFFFF"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="CapResultSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="CapResultCaptionBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="CapResultSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="CapResultSelectionTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
      <SolidColorBrush x:Key="CapResultHoverStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="CapResultRestStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="CapResultSelectedCaptionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <DataTemplate x:Key="CapHomeGroupHeaderTemplate"><TextBlock language:LanguageText.Literal="{Binding Title}" language:LanguageText.Key="{Binding TitleKey}" FontSize="12" Opacity="0.6" Margin="8,8,0,4"/></DataTemplate>
  <DataTemplate x:Key="CapAssetListTemplate">
    <StackPanel Orientation="Horizontal" Spacing="18" Padding="6">
      <FontIcon Glyph="{Binding Glyph}" FontSize="16"/>
      <TextBlock language:LanguageText.Literal="{Binding Name}" Width="300" TextTrimming="CharacterEllipsis"/>
      <TextBlock language:LanguageText.Literal="{Binding SizeLabel}" language:LanguageText.Key="{Binding SizeResourceKey}" Width="90"/>
      <TextBlock Text="{Binding ModifiedLabel}" Width="150"/>
      <TextBlock Text="{Binding FullPath}" Opacity="0.55" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
  </DataTemplate>

  <Style x:Key="CapResultSurface" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CapResultSurfaceBrush}"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="CapResultCaption" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CapResultCaptionBrush}"/></Style>
  <Style x:Key="CapResultCaptionSelected" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CapResultSelectedCaptionBrush}"/></Style>
  <Style x:Key="CapResultRestStroke" TargetType="Border"><Setter Property="BorderBrush" Value="{ThemeResource CapResultRestStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="CapResultHover" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource CapResultHoverStrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="CapResultSelected" TargetType="Border"><Setter Property="BorderBrush" Value="{ThemeResource CapResultSelectionBrush}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="CapResultTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}"/></Style>
  <Style x:Key="CapResultTitleHover" TargetType="TextBlock" BasedOn="{StaticResource CapResultTitle}"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
  <Style x:Key="CapResultTitleSelected" TargetType="TextBlock" BasedOn="{StaticResource CapResultTitle}"><Setter Property="Foreground" Value="{ThemeResource CapResultSelectionTextBrush}"/></Style>
  <Style x:Key="CapResultItem" TargetType="GridViewItem">
    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,5,5"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="CornerRadius" Value="8"/>
    <Setter Property="UseSystemFocusVisuals" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewItem"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Control.IsTemplateFocusTarget="True"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CapGalleryItem" TargetType="ToggleButton">
    <Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="CornerRadius" Value="8"/>
    <Setter Property="UseSystemFocusVisuals" Value="False"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Control.IsTemplateFocusTarget="True"/></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
