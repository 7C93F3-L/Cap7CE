<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CapResultSurfaceBrush" Color="#99FFFFFF"/>
      <SolidColorBrush x:Key="CapResultCaptionBrush" Color="#08000000"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Default">
      <SolidColorBrush x:Key="CapResultSurfaceBrush" Color="#0FFFFFFF"/>
      <SolidColorBrush x:Key="CapResultCaptionBrush" Color="#18000000"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="CapResultSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="CapResultCaptionBrush" Color="{ThemeResource SystemColorWindowColor}"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="CapResultSurface" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CapResultSurfaceBrush}"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="CapResultCaption" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CapResultCaptionBrush}"/></Style>
  <Style x:Key="CapResultCaptionSelected" TargetType="Border"><Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/><Setter Property="Opacity" Value="0.18"/></Style>
  <Style x:Key="CapResultHoverFill" TargetType="Border"><Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="CapResultHover" TargetType="Border">
    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style x:Key="CapResultSelected" TargetType="Border"><Setter Property="BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="CapResultTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/></Style>
  <Style x:Key="CapResultItem" TargetType="GridViewItem">
    <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="4"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="CornerRadius" Value="8"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridViewItem"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Control.IsTemplateFocusTarget="True"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CapGalleryItem" TargetType="ToggleButton">
    <Setter Property="Padding" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="CornerRadius" Value="8"/>
    <Setter Property="UseSystemFocusVisuals" Value="True"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Control.IsTemplateFocusTarget="True"/></ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
