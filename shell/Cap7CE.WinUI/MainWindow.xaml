<Window x:Class="Cap7CE.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Cap7CE.WinUI.Controls" Title="">
  <ContentControl x:Name="Surface" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid x:Name="Root" Background="Transparent" Padding="0,0,8,8" ColumnSpacing="8" RowSpacing="6">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="156"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="DetailsColumn" Width="280"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <ContentControl x:Name="SidebarHost" Grid.RowSpan="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
      <controls:PaneResizer x:Name="SidebarSizer" Grid.RowSpan="2" Width="8" HorizontalAlignment="Right" Margin="0,0,-6,0" AutomationProperties.Name="目录栏宽度"/>
      <ContentControl x:Name="FilterHost" Grid.Column="1" Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch"/>
      <Border x:Name="MainBorder" Grid.Row="1" Grid.Column="1" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CapWorkspaceSurfaceBrush}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TabView x:Name="Tabs" IsAddTabButtonVisible="True" CanDragTabs="False" TabWidthMode="SizeToContent" Margin="2,0,2,0"/>
          <ContentControl Grid.Row="1" x:Name="ToolbarHost" HorizontalContentAlignment="Stretch"/>
          <ContentControl Grid.Row="2" x:Name="ResultsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          <ContentControl Grid.Row="2" x:Name="NoticeHost" Margin="8" VerticalAlignment="Bottom" HorizontalContentAlignment="Stretch"/>
        </Grid>
      </Border>
      <Border x:Name="DetailsBorder" Grid.Row="1" Grid.Column="2" Style="{StaticResource CapWorkspacePanel}" Padding="0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <controls:PaneResizer x:Name="DetailsSizer" AutomationProperties.Name="详细信息栏宽度"/>
          <ContentControl Grid.Column="1" x:Name="DetailsHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        </Grid>
      </Border>
    </Grid>
  </ContentControl>
</Window>
