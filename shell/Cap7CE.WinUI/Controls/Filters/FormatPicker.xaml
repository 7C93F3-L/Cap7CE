<UserControl x:Class="Cap7CE.WinUI.Controls.FormatPicker"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="300" Height="380">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.ThemeDictionaries>
   <ResourceDictionary x:Key="Light">
    <StaticResource x:Key="ListViewItemCheckBoxSelectedBrush" ResourceKey="CapAccentBrush"/>
    <StaticResource x:Key="ListViewItemCheckBoxSelectedPointerOverBrush" ResourceKey="CapAccentBrush"/>
    <StaticResource x:Key="ListViewItemCheckBoxSelectedPressedBrush" ResourceKey="CapAccentBrush"/>
    <StaticResource x:Key="ListViewItemSelectionIndicatorBrush" ResourceKey="CapAccentBrush"/>
    <StaticResource x:Key="ListViewItemCheckBrush" ResourceKey="CapAccentForegroundBrush"/>
   </ResourceDictionary>
   <ResourceDictionary x:Key="Default">
    <StaticResource x:Key="ListViewItemCheckBoxSelectedBrush" ResourceKey="CapAccentBrush"/>
    <StaticResource x:Key="ListViewItemCheckBoxSelectedPointerOverBrush" ResourceKey="CapAccentBrush"/>
    <StaticResource x:Key="ListViewItemCheckBoxSelectedPressedBrush" ResourceKey="CapAccentBrush"/>
    <StaticResource x:Key="ListViewItemSelectionIndicatorBrush" ResourceKey="CapAccentBrush"/>
    <StaticResource x:Key="ListViewItemCheckBrush" ResourceKey="CapAccentForegroundBrush"/>
   </ResourceDictionary>
   <ResourceDictionary x:Key="HighContrast">
    <StaticResource x:Key="ListViewItemCheckBoxSelectedBrush" ResourceKey="SystemColorHighlightColorBrush"/>
    <StaticResource x:Key="ListViewItemCheckBoxSelectedPointerOverBrush" ResourceKey="SystemColorHighlightColorBrush"/>
    <StaticResource x:Key="ListViewItemCheckBoxSelectedPressedBrush" ResourceKey="SystemColorHighlightColorBrush"/>
    <StaticResource x:Key="ListViewItemSelectionIndicatorBrush" ResourceKey="SystemColorHighlightColorBrush"/>
    <StaticResource x:Key="ListViewItemCheckBrush" ResourceKey="SystemColorHighlightTextColorBrush"/>
   </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries></ResourceDictionary>
 </UserControl.Resources>
 <Grid RowSpacing="8">
  <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="300"/><RowDefinition Height="32"/></Grid.RowDefinitions>
  <SemanticZoom x:Name="Zoom" Grid.RowSpan="2" IsZoomedInViewActive="False" IsZoomOutButtonEnabled="False" ViewChangeCompleted="ViewChanged">
   <SemanticZoom.ZoomedOutView>
    <GridView x:Name="Letters" SelectionMode="None" IsItemClickEnabled="True" Width="280" Height="280" Padding="0"
      HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled">
     <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" ItemWidth="70" ItemHeight="40"/></ItemsPanelTemplate></GridView.ItemsPanel>
     <GridView.ItemContainerStyle><Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2"/>
      <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
     </Style></GridView.ItemContainerStyle>
     <GridView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Group.Key}" FontSize="18"/></DataTemplate></GridView.ItemTemplate>
    </GridView>
   </SemanticZoom.ZoomedOutView>
   <SemanticZoom.ZoomedInView>
    <ListView x:Name="Formats" SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True" Margin="0,40,0,0"
      ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled"
      SelectionChanged="SelectionChanged">
     <ListView.GroupStyle><GroupStyle HidesIfEmpty="True"><GroupStyle.HeaderTemplate><DataTemplate>
      <Button Content="{Binding Key}" Click="ShowIndex" Margin="0,4" AutomationProperties.Name="返回首字母索引"/>
     </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle>
     <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" VerticalAlignment="Center"/></DataTemplate></ListView.ItemTemplate>
    </ListView>
   </SemanticZoom.ZoomedInView>
  </SemanticZoom>
  <Button x:Name="BackButton" Content="‹ 返回" Click="ShowIndex" Visibility="Collapsed" HorizontalAlignment="Left"/>
  <Grid Grid.Row="2" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button Content="全不选" Click="ClearSelection"/>
   <TextBlock x:Name="Summary" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
   <Button Content="应用" Grid.Column="2" Click="ApplySelection"/>
  </Grid>
 </Grid>
</UserControl>
