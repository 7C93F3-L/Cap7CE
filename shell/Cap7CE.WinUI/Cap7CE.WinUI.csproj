<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../build/icon.ico</ApplicationIcon>
    <Version>2.0.5</Version>
    <Product>Cap7CE</Product>
    <Company>7C93F3-L</Company>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <Description></Description>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../core/deployment/capability-setup-manifest.v1.json" LogicalName="Cap7CE.CoreRuntimePolicy.json" />
    <Content Include="../../build/icon.ico" Link="Assets/app.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Localization/messages.json" Link="Assets/languages.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../third_party/fluentui-system-icons/LICENSE" Link="Assets/fluentui-system-icons-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Localization/settings-help.json" Link="Assets/settings-help.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/icons/skim-location-desktop.svg;../../resources/icons/skim-location-documents.svg;../../resources/icons/skim-location-downloads.svg;../../resources/icons/skim-location-pictures.svg;../../resources/icons/skim-location-music.svg;../../resources/icons/skim-location-videos.svg" Link="Assets/Icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../../resources/icons/lucide-*.svg;../../resources/icons/lucide-LICENSE.txt" Link="Assets/Icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../resources/icons/format-*.svg;../../resources/icons/skim-folder.svg;../../resources/icons/skim-file.svg;../../resources/icons/skim-disk.svg;../../resources/icons/logo-cap7ce.svg" Link="Assets/Icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../artifacts/assets/*.json" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../artifacts/model-preview/**/*" Link="Assets/ModelPreview/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../resources/branding/phase7.dat" Link="Assets/phase7.dat" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="AngleSharp" Version="1.8.4" />
    <ProjectReference Include="../../core/src/Cap7CE.Core.Protocol/Cap7CE.Core.Protocol.csproj" />
  </ItemGroup>
  <Target Name="PublishNativeResources" AfterTargets="Publish">
    <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="WinUI resource index is missing." />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
