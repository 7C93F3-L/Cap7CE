<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../src/renderer/assets/icons/skim-location-desktop.svg;../../src/renderer/assets/icons/skim-location-documents.svg;../../src/renderer/assets/icons/skim-location-downloads.svg;../../src/renderer/assets/icons/skim-location-pictures.svg;../../src/renderer/assets/icons/skim-location-music.svg;../../src/renderer/assets/icons/skim-location-videos.svg" Link="Assets/Icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="../../src/renderer/assets/icons/format-*.svg;../../src/renderer/assets/icons/skim-folder.svg;../../src/renderer/assets/icons/skim-file.svg;../../src/renderer/assets/icons/skim-disk.svg;../../src/renderer/assets/icons/logo-cap7ce.svg" Link="Assets/Icons/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../artifacts/assets/*.json" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260209005" />
    <ProjectReference Include="../../core/src/Cap7CE.Core.Protocol/Cap7CE.Core.Protocol.csproj" />
  </ItemGroup>
</Project>
